# Application
APP_NAME=AI Electricity Scenario Analysis API
APP_VERSION=1.0.0
DEBUG=True

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# MongoDB
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?appName=your-app
DATABASE_NAME=research-project
DB_CONNECT_ON_STARTUP=True
DB_SERVER_SELECTION_TIMEOUT_MS=10000

# AI provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro
